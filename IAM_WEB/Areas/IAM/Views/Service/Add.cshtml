@model ModelLayer.Models.IAM.Service.ServiceRequestModel;
@{
	ViewData["Title"] = (Model?.Service_Id ?? 0) > 0 ? "Edit" : "Add";
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@section Styles {
	<link href="@Url.Content("~/css/customized.css")" rel="stylesheet" />
}

<div class="main-body">
	<div class="row mb-4">
		<div class="col-9">
			<div class="pgHrchy">Master<i class="bi bi-chevron-right fwd"></i></div>
			<div class="pgName">@((Model?.Service_Id ?? 0) > 0 ? "Edit" : "Add") Service</div>
		</div>
		<div class="col-3 text-end">
			<a href="@Url.Content("~/IAM/Service/Index")" class="afBtn"><i class="ugo-icons">arrow_back</i></a>
		</div>
	</div>

	<div class="formbox">
		<div class="fmbdy">
			<form asp-area="IAM" asp-controller="Service" asp-action="Save" id="ServiceForm" onsubmit="SubmitForm('ServiceForm'); return false;" asp-antiforgery="true" enctype="multipart/form-data" class="frmSubmit">
				<input type="hidden" asp-for="@Model.Service_Id" id="hdnServiceId" />
				<div class="row gx-2 mb-1">
					<div class="col-9">
						<div class="row gx-2">
							<div class="col-xl-4 mbc">
								<label class="required">Name</label>
								<input name="Service_Name" type="text" asp-for="@Model.Service_Name" class="form-control" autocomplete="off" placeholder="Enter Service Name" />
								<span class="text-danger" asp-validation-for="@Model.Service_Name"></span>
							</div>
                            <div class="col-xl-4 mbc">
                                <label class="">Display Order</label>
								<input name="Display_Order" type="number" asp-for="@Model.Display_Order" class="form-control only-positive-number" autocomplete="off" placeholder="Enter Display Order" />
                                <span class="text-danger" asp-validation-for="@Model.Display_Order"></span>
                            </div>
							<div class="col-xl-7 mbc">
								<label>Description</label>
								<textarea name="Service_Desc" class="form-control" asp-for="@Model.Service_Desc" rows="4" autocomplete="off" maxlength="200" placeholder="Enter Description Here"></textarea>
								<span class="text-danger" asp-validation-for="@Model.Service_Desc"></span>
							</div>
						</div>
					</div>
					<div class="col-3 d-flex justify-content-center align-items-center">
						<div class="pubox">
							<img alt="upload photo" class="uploadpic" src="@(!string.IsNullOrEmpty(Model.Service_Logo) ? Url.Content(Model.Service_Logo) : "/images/default-user.svg")" id="viewImage">
							<div class="puboxfile">
								<span class="flabel">Upload Photo</span>
								<input type="file" name="POSTED_FILE" id="fileUpload" class="uploadfile" accept=".jpg,.jpeg,.png,.gif,.bmp,.webp,.svg,.tiff,.ico" />
								<input type="hidden" name="Service_Logo" asp-for="@Model.Service_Logo" id="hdlService_Logo" class="uploadfile" />
							</div>
						</div>
					</div>
				</div>
				<div class="row gx-2">
					<div class="col-xl-1 mbc me-2">
						<label>Status</label>
						<div class="switch">
							<label>
								<input type="checkbox" name="Is_Active" asp-for="@Model.Is_Active" id="Is_Active">
								<span class="lever">
									<span class="unckeckS">No</span>
									<span class="ckeckS">Yes</span>
								</span>
							</label>
						</div>
					</div>
					<div class="col-xl-2 mbc">
						<label>Is Microservice</label>
						<div class="switch">
							<label>
								<input type="checkbox" name="Is_Microservice" asp-for="@Model.Is_Microservice" id="Is_Microservice" value="false">
								<span class="lever">
									<span class="unckeckS">InActive</span>
									<span class="ckeckS">Active</span>
								</span>
							</label>
						</div>
					</div>
				</div>
				<div class="bd-clearfix mb-3"></div>
				<div class="btn-container mt-2">
					<button type="submit" id="btnSubmit" class="btn btn-primary">Submit</button>
					<button type="button" id="btnReset" class="btn btn-outline-dark ms-1">Reset</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<script src="@Url.Content("~/scripts/iam/service/service.js").ToLower()"></script>
}