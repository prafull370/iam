@{
    ViewData["Title"] = "App Audit Log";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@section styles
{
    <link rel="stylesheet" href="@Url.Content("~/lib/datatables/datatables.bootstrap5.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/lib/datatables/responsive.bootstrap5.css")" />
    <link rel="stylesheet" href="@Url.Content("~/lib/datepicker/flatpickr.css")" />
}

<div class="main-body">
    <div class="row align-items-center mbc">
        <div class="col-9">
            <div class="pgName">App Audit Log</div>
        </div>
    </div>
    <div class="bd-clearfix mbc-sm"></div>

    <!-- Summary Cards -->
    <div class="row mbc-sm">
        <div class="col-lg-3 col-sm-6 mbc-sm">
            <div class="card h-100 bg-light">
                <div class="card-body d-flex align-items-start gap-3">
                    <div class="bg-primary bg-opacity-10 text-primary rounded p-2 d-flex">
                        <i class="ugo-icons">group</i>
                    </div>
                    <div>
                        <div class="fs-5 fw-bold text-primary" id="statTotalUsers">0</div>
                        <div class="text-muted small fw-bold">Total App Users</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-sm-6 mbc-sm">
            <div class="card h-100 bg-light">
                <div class="card-body d-flex align-items-start gap-3">
                    <div class="bg-primary bg-opacity-10 text-primary rounded p-2 d-flex">
                        <i class="ugo-icons">grid_view</i>
                    </div>
                    <div>
                        <div class="fs-5 fw-bold text-primary" id="statEventsToday">0</div>
                        <div class="text-muted small fw-bold">Events Today</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-sm-6 mbc-sm">
            <div class="card h-100 bg-light">
                <div class="card-body d-flex align-items-start gap-3">
                    <div class="bg-success bg-opacity-10 text-success rounded p-2 d-flex">
                        <i class="ugo-icons">how_to_reg</i>
                    </div>
                    <div>
                        <div class="fs-5 fw-bold text-success" id="statActiveUsersToday">0</div>
                        <div class="text-muted small fw-bold">Active Users Today</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-sm-6 mbc-sm">
            <div class="card h-100 bg-light">
                <div class="card-body d-flex align-items-start gap-3">
                    <div class="bg-primary bg-opacity-10 text-primary rounded p-2 d-flex">
                        <i class="ugo-icons">phone_android</i>
                    </div>
                    <div>
                        <div class="fs-5 fw-bold text-primary" id="statTotalDevices">0</div>
                        <div class="text-muted small fw-bold">Total Devices</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="row gx-2">
        <div class="col-lg-3 col-sm-4 mbc-sm">
            <label>Search</label>
            <input type="text" class="form-control form-control-sm" id="txtsearch" autocomplete="off" placeholder="User, login id, mobile, device...">
        </div>
        <div class="col-lg-2 col-sm-4 mbc-sm">
            <label>From Date</label>
            <input type="text" class="form-control form-control-sm" id="txtFromDate" autocomplete="off" placeholder="YYYY-MM-DD">
        </div>
        <div class="col-lg-2 col-sm-4 mbc-sm">
            <label>To Date</label>
            <input type="text" class="form-control form-control-sm" id="txtToDate" autocomplete="off" placeholder="YYYY-MM-DD">
        </div>
        <div class="col-xl-2 col-md-3 col-sm-4 col-6 mbc-sm d-flex flex-wrap align-self-end" id="dvbtn">
            <div class="btn-group">
                <button type="button" id="btnsearch" class="btn btn-sm btn-outline-filter">
                    <i class="ugo-icons">search</i>
                </button>
                <button type="button" id="btnreset" class="btn btn-sm btn-outline-filter">
                    <i class="ugo-icons">restart_alt</i>
                </button>
            </div>
        </div>
    </div>

    <div class="cardbox">
        <table class="table table-dtc thwsnw" id="tblAppAuditLog">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Mobile No</th>
                    <th>Device</th>
                    <th>Android Version</th>
                    <th>App Version</th>
                    <th>Last Activity</th>
                    <th>Total Actions</th>
                    <th>Action</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- ===================== DETAIL DRAWER (view icon) ===================== -->
<div class="offcanvas offcanvas-end w-50" tabindex="-1" id="appAuditDetailDrawer">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title d-flex align-items-center gap-2">
            <i class="ugo-icons">info</i> App Audit Log Detail
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">

        <!-- 1. User Information -->
        <div class="fw-bold text-primary mb-2">
            <span class="badge rounded-pill bg-primary me-2">1</span>User Information
        </div>
        <div class="card bg-light mb-4">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="badge rounded-pill bg-primary fs-6" id="dtlAvatar">?</span>
                    <div>
                        <div class="fw-semibold" id="dtlUser">-</div>
                        <div class="small text-muted text-break" id="dtlLoginId">-</div>
                    </div>
                </div>
                <div class="row gy-3">
                    <div class="col-6">
                        <div class="text-uppercase text-muted fw-bold small">Mobile No</div>
                        <div class="text-break" id="dtlMobile">-</div>
                    </div>
                    <div class="col-6">
                        <div class="text-uppercase text-muted fw-bold small">Total Actions</div>
                        <div class="text-break" id="dtlTotalActions">-</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Activity History (one card per action, latest first) -->
        <div class="fw-bold text-primary mb-2">
            <span class="badge rounded-pill bg-primary me-2">2</span>Activity History
        </div>
        <div id="dtlActivityList">
            <div class="text-center text-muted py-3">-</div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/lib/datatables/jquery.dataTables.min.js").ToLower()"></script>
    <script src="@Url.Content("~/lib/datatables/dataTables.bootstrap5.min.js").ToLower()"></script>
    <script src="@Url.Content("~/lib/datatables/dataTables.responsive.js").ToLower()"></script>
    <script src="@Url.Content("~/lib/datatables/responsive.bootstrap5.js").ToLower()"></script>
    <script src="@Url.Content("~/lib/datatables/dtOptions.js").ToLower()"></script>
    <script src="@Url.Content("~/lib/datepicker/flatpickr.js")"></script>

    <script src="~/scripts/iam/appauditlog/appauditlog.js"></script>
}
