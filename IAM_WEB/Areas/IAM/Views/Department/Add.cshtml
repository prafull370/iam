@model ModelLayer.Models.IAM.Department.DepartmentRequestModel
@{
	ViewData["Title"] = (Model?.Department_Id ?? 0) > 0 ? "Edit" : "Add";
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="main-body">
	<div class="row mb-4">
		<div class="col-9">
			<div class="pgHrchy">Master<i class="bi bi-chevron-right fwd"></i></div>
			<div class="pgName">@((Model?.Department_Id ?? 0) > 0 ? "Edit" : "Add") Department</div>
		</div>
		<div class="col-3 text-end">
			<a href="@Url.Content("~/IAM/Department/Index")" class="afBtn"><i class="ugo-icons">arrow_back</i></a>
		</div>
	</div>

	<div class="formbox">
		<div class="fmbdy">
			<form asp-area="IAM" asp-controller="Department" asp-action="Save" id="DepartmentForm" onsubmit="SubmitForm('DepartmentForm'); return false;" asp-antiforgery="true" enctype="multipart/form-data" class="frmSubmit">
				<input type="hidden" asp-for="@Model.Department_Id" id="hdnDepartmentId" />
				<div class="row gx-2">
					<div class="col-xl-5 mbc">
						<label class="required">Name</label>
						<input name="Department_Name" type="text" asp-for="@Model.Department_Name" class="form-control" placeholder="Enter Department Name"/>
						<span class="text-danger" asp-validation-for="@Model.Department_Name"></span>
					</div>
					<div class="col-xl-3 mbc">
						<label class="required">Code</label>
						<input name="Department_Code" type="text" asp-for="@Model.Department_Code" class="form-control" placeholder="Enter Department Code" />
						<span class="text-danger" asp-validation-for="@Model.Department_Code"></span>
					</div>
				</div>
				<div class="row gx-2">
					<div class="col-xl-8 mbc">
						<label>Description</label>
						<textarea name="Department_Desc" class="form-control" asp-for="@Model.Department_Desc" id="txtDescription" rows="3" maxlength="200" placeholder="Enter Description Here"></textarea>
						<span class="text-danger" asp-validation-for="@Model.Department_Desc"></span>
					</div>
				</div>
				<div class="row gx-2">
					<div class="col-xl-2 mbc">
						<label>Status</label>
						<div class="switch">
							<label>
								<input type="checkbox" name="Is_Active" asp-for="@Model.Is_Active" id="Is_Active"/>
								<span class="lever">
									<span class="unckeckS">No</span>
									<span class="ckeckS">Yes</span>
								</span>
							</label>
						</div>
					</div>
				</div>

				<div class="btn-container mt-2">
					<button type="submit" id="btnSubmit" class="btn btn-primary" permission-action="Add,Edit">Submit</button>
					<button type="button" id="btnReset" class="btn btn-outline-dark ms-1">Reset</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<script src="~/scripts/iam/department/department.js"></script>
	
	<script>
		$(document).ready(function () {
			if (typeof Permission !== 'undefined') {
				Permission.apply();
			}
		});
	</script>
}