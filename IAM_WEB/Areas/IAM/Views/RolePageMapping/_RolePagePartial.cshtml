@model List<ModelLayer.Models.IAM.RolePageMapping.ProductViewModel>;
@using ModelLayer.Models.IAM.RolePageMapping

@{
    // Unique key per page row, used by the script to resolve a page's ancestors
    // (data-parent-node) when a nested page is activated.
    int nodeSeq = 0;

    // Connector rails: one slot per ancestor (line drawn when that ancestor has
    // more siblings below) plus this row's own branch slot.
    void RenderRails(List<bool> ancestors, bool hasMoreSiblings)
    {
        <span class="tree-rails">
            @foreach (var more in ancestors)
            {
                <span class="rail @(more ? "rail-line" : "")"></span>
            }
            <span class="rail rail-own @(hasMoreSiblings ? "rail-more" : "")"></span>
        </span>
    }

    void RenderToggle(bool hasChildren)
    {
        if (hasChildren)
        {
            <i class="toggle-icon ugo-icons">keyboard_arrow_down</i>
        }
        else
        {
            <span class="toggle-icon-spacer"></span>
        }
    }

    // N-level page renderer (Level 1 root page down to Level 5).
    void RenderPages(List<PageViewModel> pages, int rowLevel, List<bool> ancestors, int productId, int serviceId, int moduleId, string parentKey)
    {
        for (int pi = 0; pi < pages.Count; pi++)
        {
            var pg = pages[pi];
            bool pageMore = pi < pages.Count - 1;
            bool pageHasChildren = pg.ChildPages.Any();
            var nodeKey = "pg-" + (++nodeSeq);

            <tr class="level-@rowLevel page page-row page-lvl-@pg.Page_Level @(pageHasChildren ? "parentpage" : "") @(moduleId == 0 ? "notmodule" : "") d-none"
                data-node="@nodeKey" data-parent-node="@parentKey">
                <td class="hierarchy-col @(pageHasChildren ? "toggle-parent" : "")" data-level="@(ancestors.Count + 1)"
                    @(pageHasChildren ? Html.Raw("tabindex=\"0\" aria-expanded=\"false\"") : Html.Raw(""))>
                    <div class="tree-node">
                        @{ RenderRails(ancestors, pageMore); }
                        @{ RenderToggle(pageHasChildren); }
                        @*<span class="lvl-chip lvl-@pg.Page_Level" title="Page Level @pg.Page_Level">L@(pg.Page_Level)</span>*@
                        <span class="tree-label" title="@pg.Page_Name">@pg.Page_Name</span>
                        @*@if (pageHasChildren)
                        {
                            <span class="node-count" title="Active pages"></span>
                        }*@
                    </div>
                </td>
                <td class="text-center">
                    <span class="toggle-switch">
                        <input type="checkbox"
                               class="page-checkbox"
                               aria-label="Active - @pg.Page_Name"
                               data-product-id="@productId"
                               data-service-id="@serviceId"
                               data-module-id="@moduleId"
                               data-page-id="@pg.Page_Id"
                               data-is-parent="@(pg.Is_Parent ? "true" : "false")"
                        @(pg.Is_Page_Mapped ? "checked" : "") />
                        <span class="toggle-slider"></span>
                    </span>
                </td>
                <td class="text-center">
                    @if (!pageHasChildren)
                    {
                        <input type="radio"
                               @* name="landingPage_@serviceId" *@
                               name="landingPage_@(serviceId)_@(moduleId)"
                               aria-label="Landing Page - @pg.Page_Name"
                               data-product-id="@productId"
                               data-service-id="@serviceId"
                               data-module-id="@moduleId"
                               data-page-id="@pg.Page_Id"
                               data-is-parent="@(pg.Is_Parent ? "true" : "false")"
                        @(pg.Is_Landing_Page ? "checked" : "") />
                    }
                </td>
            </tr>

            if (pageHasChildren)
            {
                RenderPages(pg.ChildPages, rowLevel + 1, ancestors.Append(pageMore).ToList(), productId, serviceId, moduleId, nodeKey);
            }
        }
    }
}

@if (Model?.Any() == true)
{
    <colgroup>
        <col />
        <col class="col-active" />
        <col class="col-landing" />
    </colgroup>
    <thead>
        <tr>
            <th>Structure Name
                <div class="hrchy">
                    Product Name <i class="ugo-icons"> chevron_right </i> Service Name <i class="ugo-icons"> chevron_right </i> Module <i class="ugo-icons"> chevron_right </i> Page
                    @* <span class="lvl-legend" title="Page levels: L1 is a root page, L5 the deepest sub page">
                        @for (int lvl = 1; lvl <= 5; lvl++)
                        {
                            <span class="lvl-chip lvl-@lvl">L@(lvl)</span>
                        }
                    </span> *@
                </div>
            </th>
            <th class="text-center">Active</th>
            <th class="text-center">Landing Page</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            bool productHasChildren = product.Services.Count > 0;

            <tr class="level-0 toggle-row node-product">
                <td class="hierarchy-col @(productHasChildren ? "toggle-parent" : "")" data-level="0"
                    @(productHasChildren ? Html.Raw("tabindex=\"0\" aria-expanded=\"false\"") : Html.Raw(""))>
                    <div class="tree-node">
                        @{ RenderToggle(productHasChildren); }
                        <span class="tree-label" title="@product.Product_Name">@product.Product_Name</span>
                        <span class="node-type">Product</span>
                        @* <span class="node-count" title="Active pages"></span> *@
                    </div>
                </td>
                <td colspan="2"></td>
            </tr>

            for (int si = 0; si < product.Services.Count; si++)
            {
                var service = product.Services[si];
                bool serviceMore = si < product.Services.Count - 1;
                bool serviceHasChildren = service.Modules.Count > 0 || service.ParentPages.Count > 0;

                <tr class="level-1 toggle-row node-service d-none">
                    <td class="hierarchy-col @(serviceHasChildren ? "toggle-parent" : "")" data-level="1"
                        @(serviceHasChildren ? Html.Raw("tabindex=\"0\" aria-expanded=\"false\"") : Html.Raw(""))>
                        <div class="tree-node">
                            @{ RenderRails(new List<bool>(), serviceMore); }
                            @{ RenderToggle(serviceHasChildren); }
                            <span class="tree-label" title="@service.Service_Name">@service.Service_Name</span>
                            <span class="node-type">Service</span>
                            @* @if (serviceHasChildren)
                            {
                                <span class="node-count" title="Active pages"></span>
                            } *@
                        </div>
                    </td>
                    <td colspan="2"></td>
                </tr>

                for (int mi = 0; mi < service.Modules.Count; mi++)
                {
                    var module = service.Modules[mi];
                    // Pages mapped directly to the service are rendered after the modules,
                    // so the last module still has siblings below it when they exist.
                    bool moduleMore = mi < service.Modules.Count - 1 || service.ParentPages.Count > 0;
                    bool moduleHasChildren = module.ParentPages.Count > 0;

                    <tr class="level-2 toggle-row node-module d-none">
                        <td class="hierarchy-col @(moduleHasChildren ? "toggle-parent" : "")" data-level="2"
                            @(moduleHasChildren ? Html.Raw("tabindex=\"0\" aria-expanded=\"false\"") : Html.Raw(""))>
                            <div class="tree-node">
                                @{ RenderRails(new List<bool> { serviceMore }, moduleMore); }
                                @{ RenderToggle(moduleHasChildren); }
                                <span class="tree-label" title="@module.Module_Name">@module.Module_Name</span>
                                <span class="node-type">Module</span>
                               @*  @if (moduleHasChildren)
                                {
                                    <span class="node-count" title="Active pages"></span>
                                } *@
                            </div>
                        </td>
                        <td colspan="2"></td>
                    </tr>

                    RenderPages(module.ParentPages, 3, new List<bool> { serviceMore, moduleMore }, product.Product_Id, service.Service_Id, module.Module_Id, "");
                }

                // Pages mapped directly to the service (no module)
                RenderPages(service.ParentPages, 2, new List<bool> { serviceMore }, product.Product_Id, service.Service_Id, 0, "");
            }
        }
        <tr class="rpm-no-match d-none">
            <td colspan="3" class="text-center">No pages match your search.</td>
        </tr>
    </tbody>
}
