@model ModelLayer.Models.IAM.DiscomProductMapping.DiscomProductMappingRequestModel;
@{
    ViewData["Title"] = "Add Discom Product Mapping";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/lib/select2/select2.min.css")" />
}

<div class="main-body">
    <div class="row align-items-center mbc">
        <div class="col-9">
            <div class="pgName">Discom Product Mapping</div>
        </div>
    </div>
    <div class="bd-clearfix mbc-sm"></div>

    <form asp-area="IAM" asp-controller="DiscomProductMapping" asp-action="Save" id="DPMForm" onsubmit="SubmitForm('DPMForm'); return false;" asp-antiforgery="true" enctype="multipart/form-data" class="frmSubmit">
        <div class="row gx-2">
            <div class="col-lg-3 col-sm-4 mbc">
                <label class="required">Discom Name</label>
                <select name="Discom_Id" asp-for="@Model.Discom_Id" asp-items="@(new SelectList(ViewBag.DiscomList, "Id", "Name"))" class="form-control dropdown slct2" id="DDLDiscomId">
                    <option value="">Select</option>
                </select>
                <span class="text-danger" asp-validation-for="@Model.Discom_Id"></span>
            </div>
        </div>
        <!-- Empty State -->
        <div class="emptydiv text-center" id="imgchooseflt">
            <img class="fltr-img" src="/images/no_data.svg" height="135" />
            <div class="fltr-desc">
                No records to display at the moment.<br />
                Please select a Discom to view the available Product.
            </div>
        </div>
        <div class="d-none" id="btn">
            <div class="formbox">
                <div class="fmbdy">
                    <div class="pbtitle">Product List</div>
                    <div id="productListPartial"></div>
                    <div class="bd-clearfix my-3"></div>
                    <div class="btn-container">
                        <button type="submit" id="btnSubmit" class="btn btn-primary">Submit</button>
                        <button type="button" id="btnReset" class="btn btn-outline-dark ms-1">Reset</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="@Url.Content("~/lib/select2/select2.min.js".ToLower())" asp-append-version="true"></script>
    <script src="@Url.Content("~/scripts/iam/DiscomProductMapping/DiscomProductMapping.js").ToLower()"></script>
}