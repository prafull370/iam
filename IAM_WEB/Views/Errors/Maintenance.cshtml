@{
    ViewData["Title"] = ":( Maintenance";
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-control" content="public">
    <meta name="theme-color" content="#0599EF" />
    <base href='@Url.Content("~/")' />
    <title>@ViewData["Title"]</title>
    <base href='@Url.Content("~/")' />
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/favicon.ico")" />
    <!-- PNG Icons -->
    <link rel="icon" type="image/png" sizes="16x16" href="@Url.Content("~/favicon-16x16.png")">
    <link rel="icon" type="image/png" sizes="32x32" href="@Url.Content("~/favicon-32x32.png")">
    <link rel="icon" type="image/png" sizes="192x192" href="@Url.Content("~/android-chrome-192x192.png")">
    <link rel="icon" type="image/png" sizes="512x512" href="@Url.Content("~/android-chrome-512x512.png")">
    <!-- Apple Touch Icon -->
    <link rel="apple-touch-icon" sizes="180x180" href="@Url.Content("~/apple-touch-icon.png")">
    <!-- Web App Manifest -->
    <link rel="manifest" href="@Url.Content("~/site.webmanifest")">
    <link href="@Url.Content("~/css/ugo-icons.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/font-family.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/bscss.min.css")" rel="stylesheet" />
    <style>
        html, body {
            height: 100%;
        }
    </style>
</head>
<body class="error-body">
    <div class="container">
        <div class="row gx-5 align-items-center">
            <div class="col-lg-5 d-flex flex-column align-items-center">
                <h1 class="error-number fse">:( &#9881</h1>
                <h2 class="error-title">Under Maintenance</h2>
                <p class="error-text">
                    We'll be back.<br />
                    We are busy updating the Server for your.
                    Please check back soon.
                </p>
                <a href="javascript: history.go(-1)" class="btn btn-primary btn-lg"><i class="ugo-icons me-1 fs-4">arrow_back</i>Back to Home</a>
            </div>
            <div class="col-8 col-lg-6 mb-5 mb-lg-0">
                <dotlottie-player src="https://lottie.host/c1bac303-1386-4d90-803b-050c42d635fa/JYUbRmHbzP.lottie" background="transparent" speed="1" class="errImg" loop autoplay></dotlottie-player>
            </div>
        </div>
    </div>
    <script src="@Url.Content("~/lib/jquery/dist/jquery.min.js")"></script>
    <script src="@Url.Content("~/js/custom.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/lib/lottiefiles/dotlottie-player.mjs")" type="module"></script>
</body>
</html>