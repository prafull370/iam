@model ModelLayer.Models.IAM.User.UserChangePasswordModel;
@{
    ViewData["Title"] = "Change Password";
    Layout = null;
}

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-control" content="public">
    <meta name="theme-color" content="#1dacb4" />
    <meta name="robots" content="noindex">
    <title>@ViewData["Title"] - IAM</title>
    <base href='@Url.Content("~/")' />
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/favicon.ico")" />
    <!-- PNG Icons -->
    <link rel="icon" type="image/png" sizes="16x16" href="@Url.Content("~/favicon-16x16.png")">
    <link rel="icon" type="image/png" sizes="32x32" href="@Url.Content("~/favicon-32x32.png")">
    <link rel="icon" type="image/png" sizes="192x192" href="@Url.Content("~/android-chrome-192x192.png")">
    <link rel="icon" type="image/png" sizes="512x512" href="@Url.Content("~/android-chrome-512x512.png")">
    <!-- Apple Touch Icon -->
    <link rel="apple-touch-icon" sizes="180x180" href="@Url.Content("~/apple-touch-icon.png")">
    <!-- Web App Manifest -->
    <link rel="manifest" href="@Url.Content("~/site.webmanifest")">
    <link href="@Url.Content("~/css/ugo-icons.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/font-family.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/bscss.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/custom.css")" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/account.css" rel="stylesheet" />
</head>
<body>
    <div class="lg-page">
        <div class="lg-card">
            <!-- LEFT PANEL : BRAND / WELCOME -->
            <div class="lg-brandpanel" aria-hidden="true">
                <div class="lg-noise"></div>
                <svg class="lg-arcs" viewBox="0 0 400 500" fill="none" preserveAspectRatio="xMaxYMin meet">
                    <circle cx="420" cy="20" r="120" stroke="rgba(255,255,255,.16)" stroke-width="1.5" />
                    <circle cx="420" cy="20" r="220" stroke="rgba(255,255,255,.12)" stroke-width="1.5" />
                    <circle cx="420" cy="20" r="320" stroke="rgba(255,255,255,.08)" stroke-width="1.5" />
                </svg>

                <div class="lg-brand-main">
                    <div class="login-brand-mark">
                        <img src="/images/ugo-u.svg" alt="UGO">
                    </div>
                    <div class="lg-brand-content">
                        <h1>Keep your<br />account secure</h1>
                        <p class="lg-brand-sub">Choose a strong, unique password to protect your account.</p>
                    </div>
                </div>

                <div class="lg-brand-foot">© @DateTime.Now.Year &middot; All rights reserved.</div>
            </div>

            <!-- RIGHT PANEL : CHANGE PASSWORD FORM -->
            <div class="lg-formpanel">
                <div class="lg-form-inner">
                    <img src="@Url.Content("~/images/logo-ugo-one.svg")" alt="Logo" class="lg-logo">

                    <div class="lg-head">
                        <h2>Change your password</h2>
                        <p>Enter your current password to continue.</p>
                    </div>

                    <form asp-action="ChangePassword" asp-controller="Account" method="post" class="form" id="frmLogin" onsubmit="ChangePassForm('frmLogin'); return false;" asp-antiforgery="true" enctype="multipart/form-data" class="frmSubmit">
                        <div class="lg-field">
                            <label for="currentpsd" class="lg-label">Current password</label>
                            <div class="lg-input-wrap position-relative">
                                <input type="password" asp-for="@Model.Current_Password" placeholder="Enter current password" class="lg-input" id="currentpsd" autocomplete="current-password" />
                                <span class="show-pass eye toggle-password" data-target="currentpsd">
                                    <i class="ugo-icons vsbltyoff">visibility_off</i>
                                    <i class="ugo-icons vsblty"> visibility </i>
                                </span>
                            </div>
                            <span class="text-danger lg-val" asp-validation-for="@Model.Current_Password"></span>
                        </div>

                        <div class="lg-field">
                            <label for="newpsd" class="lg-label">New password</label>
                            <div class="lg-input-wrap position-relative">
                                <input type="password" asp-for="@Model.New_Password" placeholder="Enter new password" class="lg-input" id="newpsd" autocomplete="new-password" />
                                <span class="show-pass eye toggle-password" data-target="newpsd">
                                    <i class="ugo-icons vsbltyoff">visibility_off</i>
                                    <i class="ugo-icons vsblty"> visibility </i>
                                </span>
                            </div>
                            <span class="text-danger lg-val" asp-validation-for="@Model.New_Password"></span>
                        </div>

                        <div class="lg-field">
                            <label for="confirmpsd" class="lg-label">Confirm password</label>
                            <div class="lg-input-wrap position-relative">
                                <input type="password" asp-for="@Model.Confirm_Password" placeholder="Re-enter new password" class="lg-input" id="confirmpsd" autocomplete="new-password" />
                                <span class="show-pass eye toggle-password" data-target="confirmpsd">
                                    <i class="ugo-icons vsbltyoff">visibility_off</i>
                                    <i class="ugo-icons vsblty"> visibility </i>
                                </span>
                            </div>
                            <span class="text-danger lg-val" asp-validation-for="@Model.Confirm_Password"></span>
                        </div>

                        <button id="updateBtn" type="submit" class="lg-btn lg-btn-primary">Update password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div id="dvProcessing" style="display:none;">
        <div class="loaderFixed">
            <img src="@Url.Content("~/images/loader.svg")" alt="Loader" />
        </div>
    </div>

    <div id="divPopUpAlert">
        <alerts></alerts>
    </div>

    <script src="@Url.Content("~/lib/jquery/dist/jquery.min.js").ToLower()"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="@Url.Content("~/lib/bootstrap/dist/js/bootstrap.bundle.min.js").ToLower()"></script>
    <script src="@Url.Content("~/js/showalert.js").ToLower()" asp-append-version="true"></script>
    <script src="@Url.Content("~/js/custom.js").ToLower()" asp-append-version="true"></script>
    <script src="@Url.Content("~/scripts/account/login.js").ToLower()" asp-append-version="true"></script>
</body>
</html>
