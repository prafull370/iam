@model ModelLayer.Models.IAM.User.ForgotPasswordInitiateModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-control" content="public">
    <meta name="theme-color" content="#1dacb4" />
    <meta name="robots" content="noindex">
    <title>@ViewData["Title"]</title>
    <base href='@Url.Content("~/")' />
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/favicon.ico")" />
    <!-- PNG Icons -->
    <link rel="icon" type="image/png" sizes="16x16" href="@Url.Content("~/favicon-16x16.png")">
    <link rel="icon" type="image/png" sizes="32x32" href="@Url.Content("~/favicon-32x32.png")">
    <link rel="icon" type="image/png" sizes="192x192" href="@Url.Content("~/android-chrome-192x192.png")">
    <link rel="icon" type="image/png" sizes="512x512" href="@Url.Content("~/android-chrome-512x512.png")">
    <!-- Apple Touch Icon -->
    <link rel="apple-touch-icon" sizes="180x180" href="@Url.Content("~/apple-touch-icon.png")">
    <!-- Web App Manifest -->
    <link rel="manifest" href="@Url.Content("~/site.webmanifest")">
    <link href="@Url.Content("~/css/ugo-icons.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/font-family.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/bscss.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/custom.css")" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/account.css" rel="stylesheet" />
    <link href="~/css/forgotpassword.css" rel="stylesheet" />
</head>

<body>
    @Html.AntiForgeryToken()

    <!-- Toast Container -->
    <div id="fpToasts" class="fp-toasts" role="status" aria-live="polite"></div>

    <!-- Main App Container -->
    <div id="fpApp"
         class="lg-page"
         data-send-url="@Url.Action("SendForgotPasswordOtp", "Account")"
         data-verify-url="@Url.Action("VerifyForgotPasswordOtp", "Account")"
         data-reset-url="@Url.Action("ResetForgotPassword", "Account")"
         data-login-url="@Url.Action("Login", "Account")">

        <div class="lg-card">
            <!-- LEFT PANEL : BRAND / WELCOME -->
            <div class="lg-brandpanel" aria-hidden="true">
                <div class="lg-noise"></div>
                <svg class="lg-arcs" viewBox="0 0 400 500" fill="none" preserveAspectRatio="xMaxYMin meet">
                    <circle cx="420" cy="20" r="120" stroke="rgba(255,255,255,.16)" stroke-width="1.5" />
                    <circle cx="420" cy="20" r="220" stroke="rgba(255,255,255,.12)" stroke-width="1.5" />
                    <circle cx="420" cy="20" r="320" stroke="rgba(255,255,255,.08)" stroke-width="1.5" />
                </svg>

                <div class="lg-brand-main">
                    <div class="login-brand-mark">
                        <img src="/images/ugo-u.svg" alt="UGO">
                    </div>
                    <div class="lg-brand-content">
                        <h1>Account recovery,<br />made simple</h1>
                        <p class="lg-brand-sub">Verify your identity and set a new password in a few quick steps.</p>
                    </div>
                </div>

                <div class="lg-brand-foot">© @DateTime.Now.Year &middot; All rights reserved.</div>
            </div>

            <!-- RIGHT PANEL : FORM -->
            <div class="lg-formpanel">
                <div class="lg-form-inner">
                    <img src="@Url.Content("~/images/logo-ugo-one.svg")" alt="Logo" class="lg-logo">

                    <!-- Progress -->
                    <div class="fp-stepper" role="progressbar" aria-valuemin="1" aria-valuemax="4" aria-valuenow="1" aria-label="Password reset progress">
                        <div class="fp-stepper-track">
                            <div class="fp-step is-active" data-step="1">
                                <div class="fp-step-dot"><span class="fp-step-num">1</span><span class="fp-step-tick">✓</span></div>
                                <div class="fp-step-label">Identify account</div>
                            </div>
                            <div class="fp-step-line"></div>
                            <div class="fp-step" data-step="2">
                                <div class="fp-step-dot"><span class="fp-step-num">2</span><span class="fp-step-tick">✓</span></div>
                                <div class="fp-step-label">Verify OTP</div>
                            </div>
                            <div class="fp-step-line"></div>
                            <div class="fp-step" data-step="3">
                                <div class="fp-step-dot"><span class="fp-step-num">3</span><span class="fp-step-tick">✓</span></div>
                                <div class="fp-step-label">New password</div>
                            </div>
                            <div class="fp-step-line"></div>
                            <div class="fp-step" data-step="4">
                                <div class="fp-step-dot"><span class="fp-step-num">4</span><span class="fp-step-tick">✓</span></div>
                                <div class="fp-step-label">Complete</div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 1: Login ID -->
                    <div id="stepLoginId" class="fp-panel is-active">
                        <div class="lg-head">
                            <h2>Forgot your password?</h2>
                            <p>Enter your email or mobile to get a verification code.</p>
                        </div>

                        <div class="lg-field">
                            <label class="lg-label" for="txtLoginId">Email or mobile number</label>
                            <div class="lg-input-wrap">
                                <input type="text" id="txtLoginId" class="lg-input" placeholder="Enter your registered email or mobile number" autocomplete="username" aria-required="true" />
                            </div>
                            <div id="errLoginId" class="lg-val" role="alert"></div>
                        </div>
                        <button type="button" id="btnSendOtp" class="lg-btn lg-btn-primary">
                            <span class="fp-spinner"></span>
                            <span class="fp-btn-text">Send OTP</span>
                        </button>
                    </div>

                    <!-- STEP 2: OTP Verification -->
                    <div id="stepOtp" class="fp-panel">
                        <div class="lg-head">
                            <h2>Enter verification code</h2>
                            <p id="lblOtpSentTo" role="status">We've sent a 6-digit code to your email/mobile.</p>
                        </div>

                        <div class="lg-field">
                            <div class="fp-field-top">
                                <label class="lg-label mb-0" for="otpBox1">Verification code</label>
                                <button type="button" id="btnResendOtp" class="fp-link" disabled>Resend OTP</button>
                            </div>
                            <div class="fp-otp" role="group" aria-label="6-digit verification code">
                                <input type="text" id="otpBox1" class="fp-otp-box" maxlength="1" inputmode="numeric" aria-label="Digit 1" />
                                <input type="text" class="fp-otp-box" maxlength="1" inputmode="numeric" aria-label="Digit 2" />
                                <input type="text" class="fp-otp-box" maxlength="1" inputmode="numeric" aria-label="Digit 3" />
                                <input type="text" class="fp-otp-box" maxlength="1" inputmode="numeric" aria-label="Digit 4" />
                                <input type="text" class="fp-otp-box" maxlength="1" inputmode="numeric" aria-label="Digit 5" />
                                <input type="text" class="fp-otp-box" maxlength="1" inputmode="numeric" aria-label="Digit 6" />
                            </div>
                            <input type="hidden" id="txtOtp" />
                            <div id="errOtp" class="lg-val" role="alert"></div>
                        </div>
                        <button type="button" id="btnVerifyOtp" class="lg-btn lg-btn-primary">
                            <span class="fp-spinner"></span>
                            <span class="fp-btn-text">Verify OTP</span>
                        </button>
                        <div class="fp-resend">
                            <span id="lblResendTimer" class="text-muted">Resend available in 60s</span>
                        </div>
                        <button type="button" id="btnBackToStep1" class="fp-link fp-change-id">Change email or mobile number</button>
                    </div>

                    <!-- STEP 3: Reset Password -->
                    <div id="stepReset" class="fp-panel">
                        <div class="lg-head">
                            <h2>Set a new password</h2>
                            <p>Choose a strong password you haven't used before.</p>
                        </div>

                        <div class="lg-field">
                            <label class="lg-label" for="txtNewPassword">New password</label>
                            <div class="lg-input-wrap position-relative">
                                <input type="password" id="txtNewPassword" class="lg-input" placeholder="Enter new password" autocomplete="new-password" aria-required="true" />
                                <button type="button" class="fp-eye" data-target="txtNewPassword" aria-label="Show or hide password" tabindex="-1">
                                    <svg viewBox="0 0 24 24"><path d="M12 5c-7 0-10 7-10 7s3 7 10 7 10-7 10-7-3-7-10-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/></svg>
                                </button>
                            </div>
                        </div>

                        <!-- Password Strength Indicator -->
                        <div class="fp-strength">
                            <div class="fp-strength-bar"><span id="strengthFill"></span></div>
                            <span id="strengthText" class="fp-strength-text">—</span>
                        </div>

                        <!-- Password Rules -->
                        <ul class="fp-rules" id="pwdRules">
                            <li data-rule="len"><i></i> 8-20 characters</li>
                            <li data-rule="upper"><i></i> Uppercase letter</li>
                            <li data-rule="lower"><i></i> Lowercase letter</li>
                            <li data-rule="digit"><i></i> Number</li>
                            <li data-rule="special"><i></i> Special character</li>
                        </ul>

                        <div class="lg-field">
                            <label class="lg-label" for="txtConfirmPassword">Confirm password</label>
                            <div class="lg-input-wrap position-relative">
                                <input type="password" id="txtConfirmPassword" class="lg-input" placeholder="Re-enter new password" autocomplete="new-password" aria-required="true" />
                                <button type="button" class="fp-eye" data-target="txtConfirmPassword" aria-label="Show or hide password" tabindex="-1">
                                    <svg viewBox="0 0 24 24"><path d="M12 5c-7 0-10 7-10 7s3 7 10 7 10-7 10-7-3-7-10-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/></svg>
                                </button>
                            </div>
                            <div id="errPassword" class="lg-val" role="alert"></div>
                        </div>

                        <button type="button" id="btnResetPassword" class="lg-btn lg-btn-primary">
                            <span class="fp-spinner"></span>
                            <span class="fp-btn-text">Reset Password</span>
                        </button>
                    </div>

                    <!-- STEP 4: Success -->
                    <div id="stepDone" class="fp-panel">
                        <div class="fp-done">
                            <div class="fp-done-ico" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>
                            </div>
                            <h2>Password reset</h2>
                            <p>Redirecting you to login&hellip;</p>
                        </div>
                    </div>

                    <!-- Back Button -->
                    <button type="button" id="btnBackToLogin" class="fp-back">
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="fp-back-ico"><path d="M20 11H7.83l4.88-4.88a1 1 0 1 0-1.41-1.41l-6.59 6.58a1 1 0 0 0 0 1.42l6.59 6.58a1 1 0 0 0 1.41-1.41L7.83 13H20a1 1 0 0 0 0-2z"/></svg>
                        Back to login
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="divPopUpAlert">
        <alerts></alerts>
    </div>

    <script src="@Url.Content("~/lib/jquery/dist/jquery.min.js").ToLower()"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="@Url.Content("~/lib/bootstrap/dist/js/bootstrap.bundle.min.js").ToLower()"></script>
    <script src="@Url.Content("~/js/showalert.js").ToLower()" asp-append-version="true"></script>
    <script src="@Url.Content("~/js/custom.js").ToLower()" asp-append-version="true"></script>
    <script>
        // Minimal fallback so the JS doesn't break if showAlert lives in a layout you're not using
        if (typeof showAlert !== 'function') {
            window.showAlert = function (msg) { alert(msg); };
        }
    </script>
    <script src="~/scripts/iam/forgotpassword/forgotpassword.js"></script>
</body>
</html>
