@model ModelLayer.Models.Common.ResponseModel<string>
@{
    ViewData["Title"] = "Verify Account";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Verify Account</title>

    <!-- Bootstrap CDN -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <style>
        body {
            background: #f5f7fa;
            font-family: 'Segoe UI', sans-serif;
        }

        .verify-container {
            max-width: 480px;
            margin: 70px auto;
        }

        .verify-card {
            border-radius: 15px;
            padding: 35px 30px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
            background: #fff;
        }

        .success-icon {
            font-size: 60px;
            color: #28a745;
        }

        .error-icon {
            font-size: 60px;
            color: #dc3545;
        }

        .verify-message {
            font-size: 20px;
            font-weight: 600;
            margin-top: 15px;
            margin-bottom: 20px;
        }

        .btn-login {
            padding: 10px 25px;
            font-size: 16px;
            border-radius: 8px;
        }
    </style>
</head>

<body>

    <div class="verify-container">
        <div class="verify-card text-center">

            @if (Model.Status)
            {
                <!-- Success UI -->
                <div class="success-icon">✔</div>
                <div class="verify-message text-success">@Model.Message</div>

                <a href="/Account/Login" class="btn btn-primary btn-login">
                    Proceed to Login
                </a>
            }
            else
            {
                <!-- Failure UI -->
                <div class="error-icon">⚠</div>
                <div class="verify-message text-danger">@Model.Message</div>

                <a href="/Account/Login" class="btn btn-outline-primary btn-login">
                    Go to Login
                </a>
            }

        </div>
    </div>

</body>
</html>
