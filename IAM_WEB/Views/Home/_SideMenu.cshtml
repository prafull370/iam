@model List<ModelLayer.Models.IAM.User.UserPagePermissionModel>;

@functions {
    // Recursive landing page URL resolver
    public static string GetLandingUrl(List<ModelLayer.Models.IAM.User.UserPagePermissionModel>? list)
    {
        if (list == null) return "";
        foreach (var p in list)
        {
            if (p.Is_Landing_Page == true && !string.IsNullOrEmpty(p.Page_Url)) return p.Page_Url;
            if (p.subMenus != null && p.subMenus.Count > 0)
            {
                var url = GetLandingUrl(p.subMenus);
                if (!string.IsNullOrEmpty(url)) return url;
            }
        }
        return "";
    }
}

<input type="hidden" id="landingPageUrl" value="@GetLandingUrl(Model)" />

@* --- N-LEVEL RECURSIVE SUBMENU HELPER --- *@
@{
    async Task RenderSubMenus(List<ModelLayer.Models.IAM.User.UserPagePermissionModel>? subList, string landingUrl)
    {
        if (subList == null || subList.Count == 0) return;

        foreach (var sub in subList)
        {
            var hasSubChild = sub.subMenus != null && sub.subMenus.Count > 0;
            var safeUrl = !string.IsNullOrEmpty(sub.Page_Url) ? "/" + sub.Page_Url.TrimStart('/') : "javascript:;";

            if (hasSubChild)
            {
                @* Intermediate Parent Node (Has sub-children) *@
                <li class="nested-sub-item">
                    <a class="nav-sub-toggle collapsed" data-bs-target="#menu_@sub.Page_Id" data-bs-toggle="collapse" href="javascript:;">
                        <i class="bi bi-circle-fill"></i>
                        <span class="sub-text">@sub.Page_Name</span>
                        <i class="ugo-icons ms-auto sub-chevron">keyboard_arrow_down</i>
                    </a>
                    <ul id="menu_@sub.Page_Id" class="nav-content collapse nested-nav-content">
                        @{
                            await RenderSubMenus(sub.subMenus, landingUrl);
                        }
                    </ul>
                </li>
            }
            else
            {
                @* Leaf Page Node *@
                <li>
                    <a href="@safeUrl" class="menulink @(landingUrl == safeUrl ? "active" : "")">
                        <i class="bi bi-circle-fill"></i>
                        <span>@sub.Page_Name</span>
                    </a>
                </li>
            }
        }
    }
}

@if (Model != null && Model.Count > 0)
{
    var landingUrl = "/" + (GetLandingUrl(Model) ?? "").TrimStart('/');

    @foreach (var item in Model)
    {
        var hasChildren = item.subMenus != null && item.subMenus.Count > 0;
        var logo = !string.IsNullOrEmpty(item.Page_Logo) ? item.Page_Logo : "/images/configuration.svg";
        var safeUrl = !string.IsNullOrEmpty(item.Page_Url) ? "/" + item.Page_Url.TrimStart('/') : "javascript:;";

        if (hasChildren)
        {
            @* Top Level Parent With Children *@
            <li class="nav-item">
                <a class="nav-link collapsed" data-bs-target="#menu_@item.Page_Id" data-bs-toggle="collapse" href="javascript:;">
                    <img src="@logo" alt="@item.Page_Name" class="smicon" height="17" width="17" onerror="this.onerror=null; this.src='/images/configuration.svg';">
                    <span class="mnunme">@item.Page_Name</span>
                    <i class="ugo-icons ms-auto">keyboard_arrow_down</i>
                </a>
                <ul id="menu_@item.Page_Id" class="nav-content collapse">
                    @{
                        await RenderSubMenus(item.subMenus, landingUrl);
                    }
                </ul>
            </li>
        }
        else
        {
            @* Top Level Single / Direct Page (No Children) *@
            <li class="nav-item">
                <a class="nav-link menulink @(landingUrl == safeUrl ? "active" : "")" href="@safeUrl">
                    <img src="@logo" alt="@item.Page_Name" class="smicon" height="17" width="17" onerror="this.onerror=null; this.src='/images/configuration.svg';">
                    <span class="mnunme">@item.Page_Name</span>
                </a>
            </li>
        }
    }
}

<style>
    /* Styling for Nested Submenus in Sidebar */
    .sidebar-nav .nested-sub-item {
        position: relative;
    }

    .sidebar-nav .nav-sub-toggle {
        display: flex;
        align-items: center;
        font-size: 13px;
        font-weight: 500;
        color: #012970;
        padding: 8px 10px 8px 38px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .sidebar-nav .nav-sub-toggle:hover,
        .sidebar-nav .nav-sub-toggle.active {
            color: #0d6efd;
            font-weight: 600;
        }

        .sidebar-nav .nav-sub-toggle i.bi-circle-fill {
            font-size: 6px;
            margin-right: 8px;
        }

        .sidebar-nav .nav-sub-toggle .sub-chevron {
            font-size: 16px;
            transition: transform 0.2s ease-in-out;
        }

        .sidebar-nav .nav-sub-toggle:not(.collapsed) .sub-chevron {
            transform: rotate(180deg);
        }

    .sidebar-nav .nested-nav-content {
        padding-left: 15px !important;
        border-left: 1px dashed #b5c3d5;
        margin-left: 42px !important;
    }
</style>

<script>
    $(document).ready(function () {
        if (!$('#sidemenu').children().length) {
            var storedSidebar = localStorage.getItem("sidebarHtml");
            if (storedSidebar) {
                $('#sidemenu').html(storedSidebar);
            }
        }
        setNavigation();
    });

    function removeUrlSlashes(url) {
        if (!url) return '';
        return url.replace(/^\/|\/$/g, '').toLowerCase();
    }

    function setNavigation() {
        var path = removeUrlSlashes(window.location.pathname);
        var activeHref = removeUrlSlashes(localStorage.getItem('activeHref') || '');
        var menuactive = false;

        // Clear previous active states
        $('#sidemenu .nav-link, #sidemenu .nav-sub-toggle, #sidemenu a.menulink').removeClass('active');
        $('#sidemenu .nav-content').removeClass('show');
        $('#sidemenu a.collapsed').attr('aria-expanded', 'false');

        // Match current page link
        $("#sidemenu a.menulink").each(function () {
            var href = removeUrlSlashes($(this).attr('href'));
            if (!menuactive && (path === href || (activeHref && activeHref === href))) {
                $(this).addClass('active');

                // ✅ CRITICAL: Open ALL ancestor accordions up to the root!
                $(this).parents('.nav-content').addClass('show');
                $(this).parents('li').children('a[data-bs-toggle="collapse"]').removeClass('collapsed').addClass('active').attr('aria-expanded', 'true');

                localStorage.setItem('activeHref', href);
                menuactive = true;
                return false;
            }
        });

        // Fallback to landing page if no active match
        if (!menuactive) {
            var landingPage = removeUrlSlashes($('#landingPageUrl').val() || '');
            if (landingPage) {
                $("#sidemenu a.menulink").each(function () {
                    var href = removeUrlSlashes($(this).attr('href'));
                    if (href === landingPage) {
                        $(this).addClass('active');
                        $(this).parents('.nav-content').addClass('show');
                        $(this).parents('li').children('a[data-bs-toggle="collapse"]').removeClass('collapsed').addClass('active').attr('aria-expanded', 'true');
                        return false;
                    }
                });
            }
        }
    }

    $("#sidemenu").on("mousedown", "a.menulink", function (e) {
        if (e.which === 1 || e.which === 3) {
            var activeHref = $(this).attr("href");
            localStorage.setItem('activeHref', activeHref);
        }
    });
</script>

<script>
    (function () {
        try {
            var perms = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model ?? new List<ModelLayer.Models.IAM.User.UserPagePermissionModel>()));
            sessionStorage.setItem('PermissionData', JSON.stringify(perms));

            if (typeof window.Permission !== 'undefined' && window.Permission.refresh) {
                try {
                    window.Permission.refresh();
                    window.Permission.apply();
                } catch (perr) {
                    console.error('PermissionHelper error', perr);
                }
            }
        } catch (ex) {
            console.error('PermissionHelper error', ex);
        }
    })();
</script>