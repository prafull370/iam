@model List<ModelLayer.Models.IAM.User.UserProductPermissionModel>;
@{
	ViewData["Title"] = "Product";
	int i = 1;
}
@if (Model != null)
{
	@foreach (var item in Model)
	{
		<div class="col-xl-2 col-sm-3 col-xs-4 col-6 mbcs product-item" data-id="@item.Product_Id" data-url="@item.Product_Url" onclick="bindService(@item.Product_Id,'@item.Product_Url');">
			<div class="srcsBox d-flex flex-column text-center">
				<a href="javascript:void(0)" class="srvcIcon">
					<div class="sIconIn">
						<img src="@(!string.IsNullOrEmpty(item.Product_Logo) ? item.Product_Logo :  "/images//configuration.svg")" height="40" width="40">
					</div>
				</a>
				<a href="javascript:void(0)" class="srvcName">@item.Product_Name</a>
			</div>
		</div>
		i++;
	}
}